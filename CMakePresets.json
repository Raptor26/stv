{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "compiler_gcc",
            "generator": "Ninja",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "compiler_clang",
            "generator": "Ninja",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "mode_utest",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "UTEST": true
            }
        },
        {
            "name": "check_clang_tidy",
            "hidden": true,
            "cacheVariables": {
                "CLANG_TIDY_ENABLE": true
            }
        },
        {
            "name": "check_asan",
            "hidden": true,
            "cacheVariables": {
                "ASAN_ENABLE": true
            }
        },
        {
            "name": "pc_unit_tests_gcc",
            "displayName": "Build unit tests on PC host with GCC",
            "description": "Unit tests on PC host with GCC",
            "inherits": [
                "compiler_gcc",
                "mode_utest"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "pc_unit_tests_clang",
            "displayName": "Build unit tests on PC host with Clang",
            "description": "Unit tests on PC host with Clang",
            "inherits": [
                "compiler_clang",
                "mode_utest"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "pc_unit_tests_clang_tidy",
            "displayName": "Build unit tests on PC host with Clang and clang-tidy",
            "description": "Unit tests on PC host with Clang and clang-tidy",
            "inherits": [
                "compiler_clang",
                "mode_utest",
                "check_clang_tidy"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "pc_unit_tests_sanitizers_gcc",
            "displayName": "Build unit tests on PC host with GCC and sanitizers",
            "description": "Unit tests on PC host with GCC and Address/UndefinedBehavior sanitizers",
            "inherits": [
                "compiler_gcc",
                "mode_utest",
                "check_asan"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "pc_unit_tests_sanitizers_clang",
            "displayName": "Build unit tests on PC host with Clang and sanitizers",
            "description": "Unit tests on PC host with Clang and Address/UndefinedBehavior sanitizers",
            "inherits": [
                "compiler_clang",
                "mode_utest",
                "check_asan"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}"
        }
    ],
    "buildPresets": [
        {
            "name": "pc_unit_tests_gcc",
            "configurePreset": "pc_unit_tests_gcc"
        },
        {
            "name": "pc_unit_tests_clang",
            "configurePreset": "pc_unit_tests_clang"
        },
        {
            "name": "pc_unit_tests_clang_tidy",
            "configurePreset": "pc_unit_tests_clang_tidy"
        },
        {
            "name": "pc_unit_tests_sanitizers_gcc",
            "configurePreset": "pc_unit_tests_sanitizers_gcc"
        },
        {
            "name": "pc_unit_tests_sanitizers_clang",
            "configurePreset": "pc_unit_tests_sanitizers_clang"
        }
    ],
    "testPresets": [
        {
            "name": "pc_unit_tests_gcc",
            "configurePreset": "pc_unit_tests_gcc",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "pc_unit_tests_clang",
            "configurePreset": "pc_unit_tests_clang",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "pc_unit_tests_clang_tidy",
            "configurePreset": "pc_unit_tests_clang_tidy",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "pc_unit_tests_sanitizers_gcc",
            "configurePreset": "pc_unit_tests_sanitizers_gcc",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "pc_unit_tests_sanitizers_clang",
            "configurePreset": "pc_unit_tests_sanitizers_clang",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
