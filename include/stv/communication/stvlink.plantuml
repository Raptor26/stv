@startuml

skinparam noteFontColor white
skinparam noteBackgroundColor #2E86AB
hide empty members

class "stv::lwrb" as lwrb {
}
note bottom of lwrb: Кольцевой буфер принятых байт\n(обёртка над библиотекой lwrb).

class usart_rx
class comport_rx
class socket_rx
note "Записывает полученные байты от uart/comport/socket в кольцевой буфер" as N1
N1 .. socket_rx
N1 .. comport_rx
N1 .. usart_rx

class "stv::serial_parser_setup" as parser_setup {
    lwrb_base_type *lwrb
    max_one_message_size
    mutex
    + set_queue<Decorator>(queue)
    + queue<Decorator>()
}
note bottom of parser_setup: Параметры инициализации парсера.\nОчереди хранятся в приватном кортеже\nstd::tuple<parsed_queue<Decorators>...>.\nДоступ к ним — через шаблонные методы\nset_queue<Decorator>() и queue<Decorator>().\nЕсли max_one_message_size == 0,\nиспользуется ёмкость кольцевого буфера.

class "stv::serial_parser" as serial_parser {
    + run() : bool
    + queue_instance<Decorator>()
    + operator bool() : bool
}

note left of serial_parser::run
Конечный автомат из двух состояний:
start_frame_and_size — поиск стартового
кадра; декоратор выбирается статическим
методом matches(b0, b1) по первым
байтам (0xAA 0xAA — stvlink_frame,
0xFD — mavlink_v2_frame, проверяется
только первый байт);
wait_message_ready — ожидание полного
кадра и проверка CRC-16 через выбранный
декоратор. При успехе служебные поля
отрезаются, а сообщение помещается в
parsed_queue<выбранный_декоратор>.
При переполнении очереди сообщение
отбрасывается.
end note

class "stv::stvlink_frame" as stvlink_frame {
    + first_byte : 0xAA
    + second_byte : 0xAA
    + header_size() : size_t
    + trailer_size() : size_t
    + total_frame_size(header) : size_t
    + is_crc_valid(total) : bool
}
note bottom of stvlink_frame: Декоратор кадра stvlink.\nCRC считается по всему кадру,\nвключая стартовую последовательность.

class "stv::mavlink_v2_frame<CrcExtraProvider>" as mavlink_v2_frame {
    + first_byte : 0xFD
    + matches(first, second) : bool
    + header_size() : size_t
    + trailer_size() : size_t
    + total_frame_size(header) : size_t
    + is_crc_valid(total) : bool
}
note bottom of mavlink_v2_frame: Декоратор кадра MAVLink v2.\nЗаголовок 3 байта (0xFD, len,\nincompat_flags), хвост — CRC-16/X.25.\nCRC считается от поля len до конца\nполезной нагрузки с досчётом байта\nCRC_EXTRA от провайдера по msgid.

class "stv::sim_buff" as sim_buff {
  + trim_head()
  + trim_tail()
  + data()
}
note top of sim_buff: RAII-контейнер, владеющий\nпамятью сообщения.

class "parsed_queue<stvlink_frame>" as parsed_queue_stv {
}
note bottom of parsed_queue_stv: Типизированная выходная очередь\nпарсера для кадров stvlink.

class "parsed_queue<mavlink_v2_frame>" as parsed_queue_mavlink {
}
note bottom of parsed_queue_mavlink: Типизированная выходная очередь\nпарсера для кадров MAVLink v2.

class "stv::stvlink_route_setup" as route_setup_stv {
    queue_type *queue_to_read
    hash_type *hash_to_write
}
note bottom of route_setup_stv: Параметры инициализации\nмаршрутизатора stvlink.

class "stv::stvlink_route" as router_stv {
    + run() : unsigned int
}
note top of router_stv: Маршрутизатор сообщений stvlink.\nЧитает parsed_queue<stvlink_frame>,\nизвлекает dst_id из заголовка\nstv::stvlink_route_tx и перемещает сообщение\nв очередь получателя. Если ключ\nотсутствует в таблице или целевая\nочередь переполнена — сообщение\nотбрасывается.

class "stv::mavlink_v2_route_setup" as route_setup_mavlink {
    parsed_queue<mavlink_v2_frame> queue_to_read
    hash_type *hash_to_write
}
note bottom of route_setup_mavlink: Параметры инициализации\nмаршрутизатора MAVLink v2.

class "stv::mavlink_v2_route" as router_mavlink {
    + run() : size_t
}
note top of router_mavlink: Маршрутизатор сообщений MAVLink v2.\nЧитает parsed_queue<mavlink_v2_frame>,\nизвлекает compid (идентификатор\nкомпонента-источника) из заголовка\nмаршрутизации и перемещает сообщение\nв очередь получателя. Если ключ\nотсутствует в таблице или целевая\nочередь переполнена — сообщение\nотбрасывается. Широковещательная\nрассылка не поддерживается.

class "etl::unordered_map<int, queue_type*>" as route_hash_table_stv {
}
note top of route_hash_table_stv: Таблица маршрутизации stvlink.\nКлюч — dst_id (идентификатор модуля\nв рамках всей системы), значение —\nуказатель на очередь получателя.

class "etl::unordered_map<int, queue_type*>" as route_hash_table_mavlink {
}
note top of route_hash_table_mavlink: Таблица маршрутизации MAVLink v2.\nКлюч — compid (идентификатор\nкомпонента-источника), значение —\nуказатель на очередь получателя.

class "telemetry_queue <<stv::sim_buff>>" as telemetry_queue {
}
note top of telemetry_queue: Очередь сообщений,\nпредназначенных модулю telemetry.

class "telemetry <<karavan::cambridge>>" as telemetry {
    + process_one() : bool
}
note bottom of telemetry: Пример модуля-получателя.\nИзвлекает сообщение из своей очереди\nи передаёт его процессору сообщений.

class "karavan::cambridge_message_processor" as msg_processor {
    + handle_message(msg) : bool
}
note bottom of msg_processor: Извлекает pack_id из заголовка\nstv::stvlink_route_tx, находит обработчик,\nсрезает заголовок маршрута (trim_head)\nи вызывает обработчик с полезной\nнагрузкой. Если не найден —\nсообщение отбрасывается.

class "etl::unordered_map<int, cambridge_message_processor_fnc_type>" as handler_hash_table {
}
note top of handler_hash_table: Таблица обработчиков.\nКлюч — pack_id (идентификатор сообщения\nв рамках модуля), значение — указатель\nна функцию-обработчик.

usart_rx o-- lwrb
comport_rx o-- lwrb
socket_rx o-- lwrb
serial_parser ..> parser_setup : конструируется из
lwrb --* serial_parser
parser_setup o-- parsed_queue_stv
parser_setup o-- parsed_queue_mavlink
serial_parser o-- parsed_queue_stv
serial_parser o-- parsed_queue_mavlink
parsed_queue_stv --o router_stv
parsed_queue_mavlink --o router_mavlink
router_stv ..> route_setup_stv : конструируется из
router_mavlink ..> route_setup_mavlink : конструируется из
router_stv o-- route_hash_table_stv
router_mavlink o-- route_hash_table_mavlink
telemetry_queue --o route_hash_table_stv : регистрация очереди\nв таблице маршрутов
telemetry_queue --* telemetry
telemetry o-- msg_processor
msg_processor o-- handler_hash_table
@enduml

## Архитектура обработки сообщений

> Декораторы протокола KrdLink (`krd_link_frame`, `krd_link_frame_tx` + `krd_link_counter`, `krd_link_route`) перенесены из `stv` в библиотеку karavan (пространство имён `karavan::`, заголовки `karavan/include/karavan/krd_link_*.hpp`) и на схеме не показаны. Вместо них в `stv/communication` добавлены декораторы MAVLink v2: парсерный кадр `stv::mavlink_v2_frame`, TX-декоратор `stv::mavlink_v2_frame_tx` + `stv::mavlink_v2_seq_counter` и маршрутизатор `stv::mavlink_v2_route`.

Обработка полученных сообщений построена в два этапа:

- **Первичное демультиплексирование (parser):** `stv::serial_parser` анализирует поток байт, выделяет кадр и проверяет его достоверность с помощью CRC. Декоратор кадра выбирается статическим методом `matches(b0, b1)` по первым байтам (`0xAA 0xAA` — `stv::stvlink_frame`, `0xFD` — `stv::mavlink_v2_frame`, проверяется только первый байт). Распарсенное сообщение помещается в типизированную выходную очередь `stv::parsed_queue<Декоратор>`, соответствующую выбранному формату.
- **Маршрутизация stvlink:** `stv::stvlink_route` читает `parsed_queue<stv::stvlink_frame>`, извлекает из заголовка `stv::stvlink_route_tx` идентификатор получателя `dst_id` и передаёт сообщение в очередь целевого модуля.
- **Маршрутизация MAVLink v2:** `stv::mavlink_v2_route` читает `parsed_queue<stv::mavlink_v2_frame>`, извлекает из заголовка маршрутизации идентификатор компонента-источника `compid`, выполняет поиск ключа в хеш-таблице и перемещает сообщение в целевую очередь. Если ключ отсутствует в таблице или целевая очередь переполнена, сообщение отбрасывается. Широковещательная рассылка не поддерживается.
- **Диспетчеризация:** программный модуль (`karavan::cambridge`) считывает идентификатор сообщения (поле `pack_id`) и вызывает соответствующий обработчик.
- **Обработка данных:** вызванный обработчик анализирует полезную нагрузку и выполняет действия согласно её содержимому.

## Пример: модуль telemetry с двумя обработчиками

Один модуль может обслуживать несколько типов сообщений. Каждый тип регистрируется в таблице обработчиков под своим `pack_id`:

```cpp
// Обработчики двух типов телеметрических сообщений.
bool handle_voltage(karavan::cambridge_message_span msg);
bool handle_current(karavan::cambridge_message_span msg);

// Регистрация обработчиков: каждому pack_id — свой обработчик.
constexpr std::pair<int, karavan::cambridge_message_processor_fnc_type>
    voltage_processing{0x01, &handle_voltage};  // pack_id = 0x01 — напряжение
constexpr std::pair<int, karavan::cambridge_message_processor_fnc_type>
    current_processing{0x02, &handle_current};  // pack_id = 0x02 — ток

const auto handlers =
    etl::make_unordered_map<int,
                            karavan::cambridge_message_processor_fnc_type>(
        voltage_processing, current_processing);

using hash_table_type =
    etl::iunordered_map<int, karavan::cambridge_message_processor_fnc_type>;
using setup_type = karavan::cambridge_setup<hash_table_type>;

karavan::cambridge<queue_type, setup_type> telemetry{
    telemetry_queue, setup_type{.hash_table = &handlers}};
```

Пусть в очереди модуля лежат два сообщения: первое с `pack_id = 0x01`, второе с `pack_id = 0x02`. Каждый вызов `process_one()` извлекает очередное сообщение и направляет его своему обработчику:

```cpp
telemetry.process_one();  // первое сообщение → handle_voltage()
telemetry.process_one();  // второе сообщение → handle_current()
```

Если `pack_id` сообщения не зарегистрирован в таблице, обработчик не вызывается, а сообщение отбрасывается (`process_one()` в любом случае удаляет его из очереди).

Данный подход вдохновлён структурой сообщений протокола MAVLink.
Представленная схема реализована и апробирована в проекте «Отблеск» и его конфигураторе.

**Преимущества:**
- **Расширяемость (принцип Open/Closed):** поддерживается добавление новых пакетов и модулей без модификации существующей логики информационного обмена.
- **Гибкость обработки:** один модуль может обслуживать несколько типов пакетов. Например, различные телеметрические данные можно отправлять с разной частотой, учитывая время их актуальности и ограничения пропускной способности канала связи.
- **Бесшовная смена источника данных:** архитектура абстрагируется от физического интерфейса (`COM-порт`, `USART`, `сокет`). Переключение порта происходит прозрачно для остальной части программы.
- **Детерминированная маршрутизация:** арбитраж сообщений реализован на основе хеш-таблиц, что гарантирует стабильное и предсказуемое время маршрутизации независимо от их количества (при отсутствии коллизий).
